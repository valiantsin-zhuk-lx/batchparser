{
	"name": "parser",
	"version": "0.0.1",
	"description": "Parse batch requests",
	"keywords": [
		"ui5",
		"openui5",
		"sapui5"
	],
	"main": "webapp/index.html",
	"devDependencies": {
		"@babel/eslint-parser": "7.14.7",
		"@sap-ux/eslint-plugin-fiori-tools": "^0.4.0",
		"@sap/eslint-plugin-ui5-jsdocs": "2.0.5",
		"@sap/ux-ui5-tooling": "1",
		"@sapui5/ts-types": "~1.146.0",
		"@ui5/cli": "^4.0.50",
		"eslint": "8.57.0",
		"eslint-plugin-fiori-custom": "2.6.7",
		"gh-pages": "^6.1.0"
	},
	"scripts": {
		"start": "fiori run --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#batchparser-display\"",
		"start-local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#batchparser-display\"",
		"build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
		"deploy": "npm run build && gh-pages -d dist",
		"lint": "eslint ./",
		"deploy-config": "fiori add deploy-config",
		"start-noflp": "fiori run --open \"index.html?sap-ui-xx-viewCache=false\"",
		"int-test": "fiori run --open 'test/integration/opaTests.qunit.html'",
		"start-variants-management": "fiori run --open \"preview.html?sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\"",
		"unit-test": "fiori run --open 'test/unit/unitTests.qunit.html'"
	},
	"sapuxLayer": "CUSTOMER_BASE"
}
